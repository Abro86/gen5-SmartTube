[nemesis]
version=1.1
id=local.abro.smarttube
name=SmartTube (Abro)
type=application
package-version=@PACKAGE_VERSION@
short-desc=Abro fork of SmartTube for Gen5W head units
depends=media.codecs@>=@CODECS_MIN_VERSION@
os=any
models=any

[app.0]
kind=apk
path=app/SmartTube.apk
package=org.smarttube.stable
component=org.smarttube.stable/com.liskovsoft.smartyoutubetv2.tv.ui.main.SplashActivity
